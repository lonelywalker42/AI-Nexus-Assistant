{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "AI Nexus Assistant",
  "version": "4.6.4",
  "identifier": "com.nexus.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Nexus Assistant",
        "width": 1360,
        "height": 860,
        "minWidth": 1200,
        "minHeight": 750,
        "decorations": false,
        "transparent": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGOEYxQzdCNzk3MjYwQTYKUldTbVlISjVleHlQbjhCcmFmaDN4anBqNEs3OE9OUU1hWGpQYSswRjhpYVlRMmtRcXhDUkozYkoK",
      "endpoints": [
        "https://github.com/lonelywalker42/AI-Nexus-Assistant/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
